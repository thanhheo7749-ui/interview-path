# Docker Compose environment variables
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ===== Database =====
DATABASE_URL=mysql+pymysql://root:123@db:3306/speakcv

# ===== AI API Keys =====
# Primary: Google Gemini (recommended, cost-effective)
GEMINI_API_KEY=your-gemini-api-key

# Fallback: OpenAI-compatible API (9Router Proxy)
OPENAI_API_KEY=sk-a4557ea6998120f5-xv10j6-c19204c9
OPENAI_BASE_URL=http://host.docker.internal:20128/v1

# Speech-to-Text (Groq Whisper)
GROQ_API_KEY=gsk_your-groq-key

# ===== AI Cost/Token Optimization =====
AI_MAX_HISTORY_MESSAGES=16
AI_TOKEN_CHAR_BUDGET=18000
AI_DEFAULT_MAX_OUTPUT_TOKENS=500
AI_ENABLE_CACHE=1
AI_CACHE_TTL_SECONDS=300
AI_ROUTER_CHAR_THRESHOLD=850
AI_ENABLE_BRAIN_RETRIEVAL=1
AI_BRAIN_RETRIEVAL_DEBUG=0
AI_BRAIN_CONTEXT_MAX_CHARS=3200
AI_USAGE_LOG_FILE=/tmp/speakcv-backend.log
OPENAI_MODEL_GPT4O_MINI=cx/gpt-5.2
OPENAI_MODEL_GPT4O=cx/gpt-5.2
# ===== Frontend OAuth =====
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ===== Admin Account (auto-created on startup) =====
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# Frontend API endpoint
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002