# Docker Compose environment variables
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ===== Database =====
DATABASE_URL=mysql+pymysql://root:your-password@db:3306/speakcv

# ===== AI API Keys =====
# Primary: Google Gemini (recommended, cost-effective)
GEMINI_API_KEY=your-gemini-api-key

# Fallback: OpenAI-compatible API (9Router Proxy)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=

# Speech-to-Text (Groq Whisper)
GROQ_API_KEY=gsk_your-groq-key

# ===== AI Cost/Token Optimization =====
AI_MAX_HISTORY_MESSAGES=12
AI_TOKEN_CHAR_BUDGET=12000
AI_DEFAULT_MAX_OUTPUT_TOKENS=300
AI_ENABLE_CACHE=1
AI_CACHE_TTL_SECONDS=120
AI_ROUTER_CHAR_THRESHOLD=900
AI_USAGE_LOG_FILE=/tmp/speakcv-backend.log
OPENAI_MODEL_GPT4O_MINI=your-model-name
OPENAI_MODEL_GPT4O=your-model-name

# ===== Admin Account (auto-created on startup) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
ADMIN_NAME=Admin
