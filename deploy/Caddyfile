{$PRIMARY_DOMAIN} {
	encode zstd gzip
	reverse_proxy interviewpath-demo:80
}

{$SPEAKCV_DOMAIN} {
	encode zstd gzip
	reverse_proxy speakcv-frontend:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	# Above MAX_UPLOAD_MB (20) plus multipart overhead. Stops oversized bodies before they reach the backend.
	request_body {
		max_size 25MB
	}
	reverse_proxy speakcv-backend:8000
}
