{
  "title": "InterviewPath — The Candidate's Journey",
  "language": "en",
  "knownTerms": ["InterviewPath", "SpeakCV", "Daehan Precision", "Hidden Gem", "Pham Thi Lan", "Tran Thi B", "Fit Compass"],
  "targetLengthSeconds": 172,
  "video": { "width": 1280, "height": 800 },
  "voice": { "voiceId": "am_adam", "speed": 0.8 },
  "zoom": { "enabled": false },
  "transition": { "type": "crossfade", "durationMs": 450 },
  "hold": { "mode": "freeze" },
  "captions": { "position": "bottom", "style": "pill" },
  "setup": {
    "preflight": "bash reseed.sh",
    "expectState": true
  },
  "intro": {
    "title": "InterviewPath",
    "subtitle": "One hiring flow, three people, no mockups",
    "durationMs": 2400
  },
  "outro": {
    "title": "InterviewPath",
    "subtitle": "The manager, the candidate, HR — all in one real flow",
    "durationMs": 2600
  },
  "scenes": [
    {
      "id": "manager-intake",
      "title": "The manager opens a role, by voice",
      "narration": "Meet the plant manager in Korea. He signs in, switches to English, and opens his hiring requests. For a new role, he skips the long form — InterviewPath records a short voice intake instead, so his own words become the brief HR will work from.",
      "actions": [
        { "op": "goto", "url": "http://localhost:5174/login" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Sign in to InterviewPath\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "#login-email" }, "text": "manager@daehan-precision.sample" },
        { "op": "type", "target": { "selector": "#login-password" }, "text": "DemoPass123!" },
        { "op": "click", "target": { "selector": "button.mt-6.w-full" }, "comment": "Sign in" },
        { "op": "waitFor", "target": { "selector": "role=button[name=\"English\"]" }, "timeoutMs": 15000 },
        { "op": "click", "target": { "selector": "role=button[name=\"English\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Company settings\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Hiring requests\"]" } },
        { "op": "waitFor", "target": { "selector": "text=Production Line Engineer (Korea HQ Line)" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "li:has-text(\"Production Line Engineer (Korea HQ Line)\")" }, "holdMs": 1600 },
        { "op": "click", "target": { "selector": "li:has-text(\"Production Line Engineer (Korea HQ Line)\") >> role=link[name=\"Start intake\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"recording-notice\"]" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"recording-notice\"]" }, "holdMs": 1800 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"intake-understood\"]" }, "holdMs": 1400 },
        { "op": "pause", "ms": 1200 },
        { "op": "click", "target": { "selector": "role=button[name=\"Sign out\"]" } }
      ]
    },
    {
      "id": "candidate-apply",
      "title": "The candidate applies, and sees her fit instantly",
      "narration": "Now the candidate's side. She finds the open Backend Developer posting, uploads her CV, and applies — no account needed yet. In seconds, InterviewPath's AI has read her CV and shows her, requirement by requirement, what it already sees evidence for. Being a strong match, she's invited straight to a spoken AI interview instead of a written test. This room is just waiting for a microphone, same as the manager's intake screen.",
      "actions": [
        { "op": "goto", "url": "http://localhost:3001/jobs/daehan-precision-backend-developer-007dff" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Backend Developer\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=button[name=\"Apply\"]" } },
        { "op": "waitFor", "target": { "selector": "role=textbox[name=\"Full name\"]" }, "timeoutMs": 8000 },
        { "op": "type", "target": { "selector": "role=textbox[name=\"Full name\"]" }, "text": "Tran Thi B" },
        { "op": "type", "target": { "selector": "role=textbox[name=\"Email address *\"]" }, "text": "tran.thib.demo@example.com" },
        { "op": "upload", "target": { "selector": "input[type=\"file\"]" }, "files": ["input/Tran_Thi_B_Backend_CV.docx"] },
        { "op": "click", "target": { "selector": "role=checkbox[name=\"I have read this and agree to it.\"]" } },
        { "op": "click", "target": { "selector": "role=button[name=\"Send my application\"]" } },
        { "op": "pause", "ms": 1500, "comment": "let the real POST land before the hard reload below" },
        { "op": "goto", "url": "http://localhost:3001/applications", "comment": "full reload so the new session token is actually read" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"My applications\"]" }, "timeoutMs": 10000 },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"See how you fit\"]" }, "timeoutMs": 20000 },
        { "op": "highlight", "target": { "selector": "role=link[name=\"See how you fit\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "role=link[name=\"See how you fit\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Fit Compass\"]" }, "timeoutMs": 10000 },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Continue to the interview\"]" }, "timeoutMs": 20000 },
        { "op": "highlight", "target": { "selector": "role=heading[name=\"Fit Compass\"]" }, "holdMs": 1200 },
        { "op": "scrollTo", "target": { "selector": "role=link[name=\"Continue to the interview\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "role=link[name=\"Continue to the interview\"]" }, "holdMs": 1600 },
        { "op": "click", "target": { "selector": "role=link[name=\"Continue to the interview\"]" } },
        { "op": "waitFor", "target": { "selector": "text=Check your microphone" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "text=Check your microphone" }, "holdMs": 1800 },
        { "op": "pause", "ms": 1400 }
      ]
    },
    {
      "id": "hr-decision",
      "title": "HR reviews the evidence board",
      "narration": "Meanwhile at HR: the evidence board for a different applicant to the same role. Pham Thi Lan sits in the Hidden Gem lane — her CV alone didn't meet the requirements, but her spoken interview did. A plain CV filter would have rejected her before anyone heard her answer a question. HR reads the evidence and approves her to move forward.",
      "actions": [
        { "op": "goto", "url": "http://localhost:5174/login" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Sign in to InterviewPath\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "#login-email" }, "text": "hr@daehan-precision.sample" },
        { "op": "type", "target": { "selector": "#login-password" }, "text": "DemoPass123!" },
        { "op": "click", "target": { "selector": "button.mt-6.w-full" }, "comment": "Sign in" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Company settings\"]" }, "timeoutMs": 15000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Jobs\"]" } },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Open board\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Open board\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"cell-hidden_gem\"]" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"cell-hidden_gem\"]" }, "holdMs": 1600 },
        { "op": "click", "target": { "selector": "text=Pham Thi Lan" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"detail-panel\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"ai-suggestion\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"ai-suggestion\"]" }, "holdMs": 1800 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"decision-bar\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "click", "target": { "selector": "[data-testid=\"decision-bar\"] >> role=button[name=\"Approve\"]" } },
        { "op": "assert", "target": { "selector": "[data-testid=\"decided-state\"]" }, "timeoutMs": 8000 },
        { "op": "pause", "ms": 1000 }
      ]
    },
    {
      "id": "hr-brief",
      "title": "HR drafts the brief the manager will read",
      "narration": "Approving isn't the end of HR's job — it's translating evidence into something the manager can act on. One click drafts a brief from the real interview quotes, in Korean. HR reads it, marks the wording reviewed, and only then can it be sent — the server refuses anything unreviewed.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "[data-testid=\"brief-workflow\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"brief-workflow\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"brief-workflow\"]" }, "holdMs": 1200 },
        { "op": "click", "target": { "selector": "role=button[name=\"Generate brief\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"brief-point\"]" }, "timeoutMs": 15000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"brief-strengths\"]" }, "holdMs": 1600 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"brief-to-clarify\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"brief-to-clarify\"]" }, "holdMs": 1600 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"brief-questions\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"brief-questions\"]" }, "holdMs": 1600 },
        { "op": "click", "target": { "selector": "role=button[name=\"Save wording and mark reviewed\"]" } },
        { "op": "waitFor", "target": { "selector": "role=button[name=\"Send to the hiring manager\"]" }, "timeoutMs": 8000 },
        { "op": "pause", "ms": 800 },
        { "op": "click", "target": { "selector": "role=button[name=\"Send to the hiring manager\"]" }, "retry": 3 },
        { "op": "assert", "target": { "selector": "[data-testid=\"brief-sent\"]" }, "timeoutMs": 8000 },
        { "op": "click", "target": { "selector": "role=button[name=\"Sign out\"]" } }
      ]
    },
    {
      "id": "manager-scorecard",
      "title": "The manager closes the loop",
      "narration": "Back to the manager. HR's brief now waits in his own interviews list — the candidate's quotes, in his language, no CV jargon. He reads it, scores each requirement, and submits his own recommendation. HR still makes the final call, but his voice shaped the question and now shapes the answer too.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Sign in to InterviewPath\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "#login-email" }, "text": "manager@daehan-precision.sample" },
        { "op": "type", "target": { "selector": "#login-password" }, "text": "DemoPass123!" },
        { "op": "click", "target": { "selector": "button.mt-6.w-full" }, "comment": "Sign in" },
        { "op": "waitFor", "target": { "selector": "role=button[name=\"English\"]" }, "timeoutMs": 15000 },
        { "op": "click", "target": { "selector": "role=button[name=\"English\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Company settings\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"My interviews\"]" } },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Open brief\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Open brief\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"scorecard-form\"]" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"brief-point\"]" }, "holdMs": 1600 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"scorecard-form\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 0 }, "label": "5 - Excellent" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 1 }, "label": "4 - Strong" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 2 }, "label": "4 - Strong" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 3 }, "label": "3 - Adequate" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 4 }, "label": "4 - Strong" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 5 }, "label": "5 - Excellent" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 6 }, "label": "5 - Excellent" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 7 }, "label": "4 - Strong" },
        { "op": "select", "target": { "selector": "[data-testid=\"scorecard-form\"] >> role=combobox", "nth": 8 }, "label": "2 - Weak" },
        { "op": "click", "target": { "selector": "role=radio[name=\"Recommend hiring\"]" } },
        { "op": "click", "target": { "selector": "role=button[name=\"Submit scorecard\"]" } },
        { "op": "assert", "target": { "selector": "[data-testid=\"scorecard-submitted\"]" }, "timeoutMs": 8000 },
        { "op": "click", "target": { "selector": "role=button[name=\"Sign out\"]" } }
      ]
    },
    {
      "id": "hr-outcome",
      "title": "HR records the hire and onboarding begins",
      "narration": "Last stop: HR. With the manager's recommendation in hand, HR records the outcome — hired — and starts the onboarding plan in one click. A candidate a CV filter would have screened out just became Daehan Precision's newest engineer, and the whole trail — manager, candidate, HR — stays attached to her file.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Sign in to InterviewPath\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "#login-email" }, "text": "hr@daehan-precision.sample" },
        { "op": "type", "target": { "selector": "#login-password" }, "text": "DemoPass123!" },
        { "op": "click", "target": { "selector": "button.mt-6.w-full" }, "comment": "Sign in" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Company settings\"]" }, "timeoutMs": 15000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Jobs\"]" } },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Open board\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Open board\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"cell-hidden_gem\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "text=Pham Thi Lan" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"outcome-control\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"outcome-control\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"outcome-control\"]" }, "holdMs": 1200 },
        { "op": "click", "target": { "selector": "[data-testid=\"outcome-control\"] >> role=button[name=\"Hired\"]" } },
        { "op": "click", "target": { "selector": "role=button[name=\"Yes, record it\"]" } },
        { "op": "assert", "target": { "selector": "[data-testid=\"outcome-recorded\"]" }, "timeoutMs": 8000 },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"onboarding-start\"]" }, "timeoutMs": 8000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"onboarding-start\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "click", "target": { "selector": "role=button[name=\"Create onboarding plan\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Onboarding plan\"]" }, "timeoutMs": 20000 },
        { "op": "highlight", "target": { "selector": "role=heading[name=\"Onboarding plan\"]" }, "holdMs": 1400 },
        { "op": "pause", "ms": 1200 }
      ]
    }
  ]
}
