{
  "title": "InterviewPath — AI-Powered HR & Recruitment Lifecycle",
  "language": "en",
  "knownTerms": ["InterviewPath", "SpeakCV", "Daehan Precision", "JD Studio", "Copilot", "TopCV", "LinkedIn", "Hidden Gem", "Pham Thi Lan", "Fit Compass"],
  "targetLengthSeconds": 150,
  "video": { "width": 1280, "height": 800 },
  "voice": { "voiceId": "am_adam", "speed": 0.8 },
  "zoom": { "enabled": false },
  "transition": { "type": "crossfade", "durationMs": 450 },
  "hold": { "mode": "freeze" },
  "captions": { "position": "bottom", "style": "pill" },
  "setup": {
    "preflight": "bash reseed.sh",
    "expectState": true
  },
  "intro": {
    "title": "InterviewPath",
    "subtitle": "AI-Powered Human Resources & Recruitment",
    "durationMs": 2400
  },
  "outro": {
    "title": "InterviewPath",
    "subtitle": "JD Studio · Smart Screening · Onboarding · Policy Copilot",
    "durationMs": 2600
  },
  "scenes": [
    {
      "id": "jd-and-channels",
      "title": "AI writes the JD and analyzes sourcing channels",
      "narration": "Our hiring journey begins in JD Studio. Instead of writing from scratch, HR generates a complete job description pulled straight from the company's verified standards in English, Vietnamese, and Korean, complete with must-have criteria and policy checks. Once published, Channel Intelligence analyzes every source — LinkedIn, TopCV, university fairs, and referrals — showing which channels deliver approved hires at the lowest cost.",
      "actions": [
        { "op": "goto", "url": "http://localhost:5174/login" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Sign in to InterviewPath\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "#login-email" }, "text": "hr@daehan-precision.sample" },
        { "op": "type", "target": { "selector": "#login-password" }, "text": "DemoPass123!" },
        { "op": "click", "target": { "selector": "button.mt-6.w-full" }, "comment": "Sign in" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Company settings\"]" }, "timeoutMs": 15000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Hiring requests\"]" } },
        { "op": "waitFor", "target": { "selector": "role=textbox[name=\"Role to hire\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "role=textbox[name=\"Role to hire\"]" }, "text": "Senior Backend Engineer" },
        { "op": "select", "target": { "selector": "role=combobox[name=\"Hiring manager\"]" }, "label": "Sample Manager" },
        { "op": "select", "target": { "selector": "role=combobox[name=\"Department\"]" }, "label": "Backend" },
        { "op": "click", "target": { "selector": "role=button[name=\"Create request\"]" } },
        { "op": "waitFor", "target": { "selector": "role=button[name=\"Generate draft\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=button[name=\"Generate draft\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"JD Studio\"]" }, "timeoutMs": 20000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"jd-lines\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "role=tab[name=\"Tiếng Việt\"]" } },
        { "op": "pause", "ms": 700 },
        { "op": "click", "target": { "selector": "role=tab[name=\"English\"]" } },
        { "op": "click", "target": { "selector": "role=link[name=\"Jobs\"]" } },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Channels\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Channels\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Channel Intelligence\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=button[name=\"Simulated data\"]" } },
        { "op": "waitFor", "target": { "selector": "text=\"linkedin\"" }, "timeoutMs": 8000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"channel-table\"]" }, "holdMs": 1500 },
        { "op": "hover", "target": { "selector": "text=\"linkedin\"" } },
        { "op": "pause", "ms": 800 },
        { "op": "hover", "target": { "selector": "text=\"topcv\"" } },
        { "op": "pause", "ms": 800 },
        { "op": "click", "target": { "selector": "role=link[name=\"Jobs\"]" } },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Open board\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=link[name=\"Open board\"]" } }
      ]
    },
    {
      "id": "cv-screening-and-ai-interview",
      "title": "AI screens CVs, HR approves, candidate completes AI interview",
      "narration": "As applications arrive, InterviewPath's AI screens every CV against the role's criteria. When a resume is held for missing keywords, HR inspects the original CV on the board and clicks 'Invite to AI interview anyway,' issuing a magic link. On the candidate portal, the applicant checks her Fit Compass, tests her microphone, and enters the live AI interview room — recording her spoken answer to question one, answering an AI follow-up question on ISO change control, and submitting the completed interview to HR.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "[data-testid=\"lane-cv_hold\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"lane-cv_hold\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"lane-cv_hold\"]" }, "holdMs": 1200 },
        { "op": "click", "target": { "selector": "text=tran.hoang.minh.demo@gmail.com" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"detail-panel\"]" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"candidate-cv-section\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "role=button[name=\"Invite to AI interview anyway\"]" } },
        { "op": "pause", "ms": 1000 },
        { "op": "goto", "url": "http://localhost:3001/claim/demo-magic-link-round1" },
        { "op": "waitFor", "target": { "selector": "button[type=\"submit\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "button[type=\"submit\"]" } },
        { "op": "pause", "ms": 1000 },
        { "op": "goto", "url": "http://localhost:3001/applications/258/fit" },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Fit Compass\"]" }, "timeoutMs": 15000 },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"Continue to the interview\"]" }, "timeoutMs": 15000 },
        { "op": "highlight", "target": { "selector": "role=heading[name=\"Fit Compass\"]" }, "holdMs": 1200 },
        { "op": "scrollTo", "target": { "selector": "role=link[name=\"Continue to the interview\"]" }, "easing": "smooth", "settleMs": 500 },
        { "op": "click", "target": { "selector": "role=link[name=\"Continue to the interview\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"consent-recording\"]" }, "timeoutMs": 10000 },
        { "op": "click", "target": { "selector": "role=button[name=\"Test microphone\"]" } },
        { "op": "pause", "ms": 600 },
        { "op": "click", "target": { "selector": "[data-testid=\"consent-recording\"]" } },
        { "op": "click", "target": { "selector": "[data-testid=\"start-session\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"question-text\"]" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"question-text\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "[data-testid=\"record-answer\"]" } },
        { "op": "pause", "ms": 2200 },
        { "op": "click", "target": { "selector": "[data-testid=\"stop-answer\"]" } },
        { "op": "waitFor", "target": { "selector": "text=Follow-up:" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"question-text\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "[data-testid=\"record-answer\"]" } },
        { "op": "pause", "ms": 2000 },
        { "op": "click", "target": { "selector": "[data-testid=\"stop-answer\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"session-complete\"]" }, "timeoutMs": 10000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"session-complete\"]" }, "holdMs": 1600 },
        { "op": "goto", "url": "http://localhost:5174/jobs/4/board" }
      ]
    },
    {
      "id": "ai-scoring-and-round2-approval",
      "title": "AI scores the interview and HR approves for Round 2",
      "narration": "After the AI interview finishes, the system scores every spoken answer against the job requirements and surfaces Pham Thi Lan as a Hidden Gem — an engineer whose paper CV looked thin, but whose interview proved real Java, Spring Boot, and ISO quality experience. HR reviews the scored evidence, approves her for round two, generates a brief from her real quotes, and sends it to the hiring manager.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "[data-testid=\"cell-hidden_gem\"]" }, "timeoutMs": 12000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"cell-hidden_gem\"]" }, "holdMs": 1600 },
        { "op": "click", "target": { "selector": "text=Pham Thi Lan" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"detail-panel\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"ai-suggestion\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"ai-suggestion\"]" }, "holdMs": 1600 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"decision-bar\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "click", "target": { "selector": "[data-testid=\"decision-bar\"] >> role=button[name=\"Approve\"]" } },
        { "op": "assert", "target": { "selector": "[data-testid=\"decided-state\"]" }, "timeoutMs": 8000 },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"brief-workflow\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"brief-workflow\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "click", "target": { "selector": "role=button[name=\"Generate brief\"]" } },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"brief-point\"]" }, "timeoutMs": 15000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"brief-strengths\"]" }, "holdMs": 1600 },
        { "op": "scrollTo", "target": { "selector": "role=button[name=\"Save wording and mark reviewed\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "click", "target": { "selector": "role=button[name=\"Save wording and mark reviewed\"]" } },
        { "op": "waitFor", "target": { "selector": "role=button[name=\"Send to the hiring manager\"]" }, "timeoutMs": 8000 },
        { "op": "pause", "ms": 800 },
        { "op": "click", "target": { "selector": "role=button[name=\"Send to the hiring manager\"]" }, "retry": 3 },
        { "op": "assert", "target": { "selector": "[data-testid=\"brief-sent\"]" }, "timeoutMs": 8000 },
        { "op": "pause", "ms": 1200 }
      ]
    },
    {
      "id": "onboarding-plan",
      "title": "HR records the hire and approves the 30-60-90 onboarding plan",
      "narration": "Once the second-round interview succeeds, HR records the final outcome as Hired and clicks Create Onboarding Plan. InterviewPath drafts a tailored thirty, sixty, and ninety day probation roadmap built from the team's knowledge base. With one click on Approve Plan, Pham Thi Lan officially transitions from candidate to probation employee.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "[data-testid=\"outcome-control\"]" }, "timeoutMs": 10000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"outcome-control\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"outcome-control\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "[data-testid=\"outcome-control\"] >> role=button[name=\"Hired\"]" } },
        { "op": "click", "target": { "selector": "role=button[name=\"Yes, record it\"]" } },
        { "op": "assert", "target": { "selector": "[data-testid=\"outcome-recorded\"]" }, "timeoutMs": 8000 },
        { "op": "waitFor", "target": { "selector": "[data-testid=\"onboarding-start\"]" }, "timeoutMs": 8000 },
        { "op": "scrollTo", "target": { "selector": "[data-testid=\"onboarding-start\"]" }, "easing": "smooth", "settleMs": 600 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"onboarding-start\"]" }, "holdMs": 1400 },
        { "op": "click", "target": { "selector": "role=button[name=\"Create onboarding plan\"]" } },
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Onboarding plan\"]" }, "timeoutMs": 20000 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"phase-30\"]" }, "holdMs": 1400 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"phase-60\"]" }, "holdMs": 1200 },
        { "op": "highlight", "target": { "selector": "[data-testid=\"phase-90\"]" }, "holdMs": 1200 },
        { "op": "click", "target": { "selector": "role=button[name=\"Approve plan\"]" } },
        { "op": "click", "target": { "selector": "role=button[name=\"Yes, approve\"]" } },
        { "op": "pause", "ms": 1200 },
        { "op": "click", "target": { "selector": "role=button[name=\"Sign out\"]" } }
      ]
    },
    {
      "id": "probation-employee-copilot",
      "title": "The probation employee checks onboarding and asks the policy chatbot",
      "narration": "Now on probation, Lan logs in as an employee, opens My Onboarding, and checks off her first Day 30 milestone. When she isn't sure about company rules — like annual leave policy and how to request time off — she clicks Ask Copilot. The internal AI assistant answers straight from the company handbook with exact source citations, and even alerts her when two policy documents disagree.",
      "actions": [
        { "op": "waitFor", "target": { "selector": "role=heading[name=\"Sign in to InterviewPath\"]" }, "timeoutMs": 10000 },
        { "op": "type", "target": { "selector": "#login-email" }, "text": "candidate.hiddengem.demo@example.com" },
        { "op": "type", "target": { "selector": "#login-password" }, "text": "UV@Candid2026!" },
        { "op": "click", "target": { "selector": "button.mt-6.w-full" }, "comment": "Sign in as new hire" },
        { "op": "waitFor", "target": { "selector": "role=link[name=\"My onboarding\"]" }, "timeoutMs": 15000 },
