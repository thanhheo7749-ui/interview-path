{
  "title": "InterviewPath — 2-Minute Product Demo",
  "language": "en",
  "knownTerms": ["InterviewPath", "JD Studio", "Copilot", "TopCV", "LinkedIn", "Daehan Precision"],
  "targetLengthSeconds": 118,
  "video": { "width": 1280, "height": 800 },
  "voice": { "voiceId": "am_adam", "speed": 0.8 },
  "zoom": { "enabled": false },
  "transition": { "type": "crossfade", "durationMs": 450 },
  "hold": { "mode": "freeze" },
