# Copy to .env and fill in. Never commit .env.

# Runtime
APP_ENV=development
LEGACY_B2C_ENABLED=false
NEXT_PUBLIC_LEGACY_B2C_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=20
# Public address of the candidate site. Tracked channel links in recruiting content are built from it.
SPEAKCV_PUBLIC_URL=http://localhost:3000
# Trusted proxy addresses for client IPs. Use * only when the backend is reachable solely through Caddy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Auth. SECRET_KEY needs at least 32 characters: openssl rand -hex 32
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Database. DATABASE_URL must use the same password as MYSQL_ROOT_PASSWORD.
# MYSQL_ROOT_PASSWORD is placed in DATABASE_URL as is, so it must be URL-safe (no @ : / ? # %).
MYSQL_DATABASE=speakcv
MYSQL_ROOT_PASSWORD=
DATABASE_URL=

# Optional platform admin, created only if absent and never overwritten
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Daily AI spend allowed per company, in US dollars (default 25). It is summed from today's ai_usage_logs rows, and a
# call with no price in pricing.yaml counts as 0, so a model missing from that file is not limited. Over the limit, the
# gateway refuses before the vendor call. A call with no company is never limited.
AI_COMPANY_DAILY_BUDGET_USD=25

# AI slots. Provider: anthropic, openai, gemini, voyage, edge_tts, fake.
# Anthropic has no embedding model and lists no speech services, so a Claude setup needs a second vendor.
AI_REASONING_PROVIDER=fake
AI_REASONING_MODEL=
AI_BULK_PROVIDER=fake
AI_BULK_MODEL=
AI_EMBEDDING_PROVIDER=fake
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=
AI_STT_PROVIDER=fake
AI_STT_MODEL=
AI_TTS_PROVIDER=fake
AI_TTS_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Optional Anthropic tuning. Effort: low, medium, high, xhigh, max.
ANTHROPIC_EFFORT=high
ANTHROPIC_FALLBACKS_ENABLED=true

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8001
VITE_API_URL=http://localhost:8001
VITE_SPEAKCV_URL=http://localhost:3000

# Ports and domains
INTERVIEWPATH_PORT=5173
SPEAKCV_FRONTEND_PORT=3000
SPEAKCV_BACKEND_PORT=8001
# scripts/vps-deploy.sh sets this for production: 127.0.0.1 behind Caddy, 0.0.0.0 without it.
SPEAKCV_BACKEND_BIND=127.0.0.1
ENABLE_PROXY=0
PUBLIC_HOST=auto
PRIMARY_DOMAIN=
SPEAKCV_DOMAIN=
API_DOMAIN=

# Legacy consumer features, used only with LEGACY_B2C_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/upgrade/success

# Uploaded company documents
STORAGE_DIR=./storage

# Candidate answer recordings
RECORDINGS_DIR=./recordings

# Optional outgoing email. Without SMTP_HOST, notifications stay in the app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
