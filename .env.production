# VPS production deployment values.
# Replace example.com values with your real domain before running scripts/vps-deploy.sh.

PRIMARY_DOMAIN=example.com
SPEAKCV_DOMAIN=speakcv.example.com
API_DOMAIN=api.example.com

VITE_SPEAKCV_URL=https://speakcv.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

CORS_ORIGINS=https://example.com,https://speakcv.example.com
VNPAY_RETURN_URL=https://speakcv.example.com/upgrade/success

MYSQL_DATABASE=speakcv
MYSQL_ROOT_PASSWORD=change-this-mysql-password
DATABASE_URL=mysql+pymysql://root:change-this-mysql-password@db:3306/speakcv

SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3000

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
